# Leave Slack/Jira blank (or set MOCK=1) to run on built-in SAMPLE data.
MOCK=1
PORT=3000
TZ_NAME=America/Mexico_City

# Slack — USER token (xoxp-...) with: search:read users:read users.profile:read
# channels:history groups:history im:history mpim:history
SLACK_USER_TOKEN=
SLACK_POLL_MS=120000
# Only if you use the Events API instead of polling (user_change, presence_change)
SLACK_SIGNING_SECRET=

# Jira Cloud — API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-company.atlassian.net
# Use the email of your ATLASSIAN account (it can differ from your work email elsewhere)
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
JIRA_PROJECTS=PROJ
JIRA_BUG_TYPE=Bug

# "Tickets tested" = tickets YOU move from QA_FROM to one of QA_TO
QA_FROM_STATUSES=In QA
QA_TO_STATUSES=Ready for UAT,Done,Won't Do
