{
  "name": "daily-time-report",
  "version": "1.0.0",
  "private": true,
  "description": "Automatic daily time report from Slack + Jira activity",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server.js",
    "mock": "MOCK=1 node server.js",
    "test": "node --test test/*.test.js",
    "export:example": "node scripts/export-static.js --from 2026-10-01 --to 2026-11-04 --out examples/oct-nov-2026.html"
  }
}
